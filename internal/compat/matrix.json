        "reason": "current compact binary revision"
      },
      "3": {
        "decision": "reject",
        "reason": "binary format revision 3 has no declared compatibility entry"
      }
    },
    "jsonl": {
      "1": {
        "decision": "downgrade_accept",
        "reason": "legacy JSONL unit and absence rules accepted with declared defaults"
      },
      "2": {
        "decision": "accept",
        "reason": "current JSONL revision"
      },
      "3": {
        "decision": "reject",
        "reason": "required fields are not present in this compatibility matrix"
      }
    }
  }
}
