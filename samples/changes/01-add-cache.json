{
  "schema_version": 1,
  "namespace": "prod/win-sandbox",
  "base_version": 1,
  "operations": [
    {
      "op": "add",
      "kind": "directory",
      "entity": {"id": "dir.cache", "path": "work\\sandbox\\cache", "parent_id": "dir.root", "access": ["read", "write"]}
    },
    {
      "op": "add",
      "kind": "rule",
      "entity": {"id": "rule.file.cache.read", "effect": "allow", "action": "file.read", "ref": "dir.cache", "depends_on": ["rule.file.data.read"]}
    },
    {
      "op": "add",
      "kind": "rule",
      "entity": {"id": "rule.file.cache.write", "effect": "allow", "action": "file.write", "ref": "dir.cache"}
    }
  ]
}
